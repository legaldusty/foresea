{
  "name": "giveway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GIVE WAY: predicts where an unknown underwater drone is heading and moves only the boats in its path.",
  "scripts": {
    "dev": "tsx watch --exclude \"./vite.config.ts.timestamp-*\" --exclude \"./src/app/**\" --exclude \"./data/**\" server/main.ts --dev",
    "build": "vite build",
    "start": "tsx server/main.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "tsx scripts/bench.ts",
    "scenarios": "tsx scripts/scenarios.ts",
    "ais:record": "tsx server/ais/record.ts",
    "noaa:fetch": "tsx server/noaa/fetch.ts",
    "tokens": "node scripts/build-tokens",
    "e2e": "playwright test",
    "certs": "tsx scripts/certs.ts",
    "tune:tell": "tsx scripts/tune-tell.ts",
    "hub:smoke": "tsx scripts/hub-smoke.ts",
    "calibration": "tsx scripts/calibration.ts",
    "train:traffic": "tsx scripts/train-traffic.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@phosphor-icons/react": "^2.1.7",
    "d3-contour": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^3.2.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.3",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.48.2",
    "@types/d3-contour": "^3.0.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "jsonc-parser": "^3.3.1",
    "parse5": "^7.2.1",
    "pbf": "^4.0.1",
    "postcss": "^8.4.47",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4",
    "yaml": "^2.6.0"
  }
}
